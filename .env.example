# Copy to .env.local for local runs (npm start / vercel dev). On Vercel, set the same names under
# Project -> Settings -> Environment Variables. All are optional; nothing here is ever sent to the browser.

# MaxMind GeoIP2 Insights (paid): the only source of a commercial ISP-level field. Use MAXMIND_SERVICE=city for City Plus.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_SERVICE=

# ipinfo.io token (free plan: geolocation + ASN) and ipapi.is key (raises the free 1000/day limit)
IPINFO_TOKEN=
IPAPI_IS_KEY=

# Override the LibreSpeed server directory, or the per-provider lookup timeout (ms, default 3000)
LIBRESPEED_LIST_URL=
LOOKUP_TIMEOUT_MS=
